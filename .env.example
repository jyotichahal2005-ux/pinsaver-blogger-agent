# Local secrets for the PinSaver Blogger agent.
# NEVER commit this file. In GitHub Actions these same values live as repository secrets.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BLOGGER_BLOG_ID=7265988019810439292

# Image API (choose one) - get free keys at:
# Pexels: https://www.pexels.com/api/ (200 req/hr, 20,000/mo)
# Unsplash: https://unsplash.com/developers (50 req/hr, 5,000/mo demo)
PEXELS_API_KEY=
UNSPLASH_API_KEY=
IMAGE_PROVIDER=pexels
